import tkinter as tk
from tkinter import messagebox

class TicTacToe:
    def __init__(self, root):
        self.root = root
        self.root.title("Tic-Tac-Toe")
        self.root.resizable(False, False)
        
        self.current_player = "X"
        self.board = [""] * 9
        
        # Status Label
        self.status_label = tk.Label(self.root, text=f"Player {self.current_player}'s Turn", font=("Arial", 14, "bold"))
        self.status_label.pack(pady=10)
        
        # Grid Frame
        self.grid_frame = tk.Frame(self.root)
        self.grid_frame.pack()
        
        # Buttons list
        self.buttons = []
        for i in range(9):
            btn = tk.Button(
                self.grid_frame, 
                text="", 
                font=("Arial", 24, "bold"), 
                width=5, 
                height=2,
                command=lambda idx=i: self.make_move(idx)
            )
            btn.grid(row=i//3, column=i%3, padx=5, pady=5)
            self.buttons.append(btn)
            
        # Reset Button
        self.reset_button = tk.Button(self.root, text="Restart Game", font=("Arial", 12), command=self.reset_game)
        self.reset_button.pack(pady=15)

    def make_move(self, idx):
        if self.board[idx] == "":
            self.board[idx] = self.current_player
            self.buttons[idx].config(text=self.current_player, state="disabled", disabledforeground="black")
            
            if self.check_win():
                self.status_label.config(text=f"Player {self.current_player} Wins!")
                messagebox.showinfo("Game Over", f"Congratulations! Player {self.current_player} wins!")
                self.disable_board()
            elif "" not in self.board:
                self.status_label.config(text="It's a Tie!")
                messagebox.showinfo("Game Over", "It's a tie!")
            else:
                self.current_player = "O" if self.current_player == "X" else "X"
                self.status_label.config(text=f"Player {self.current_player}'s Turn")

    def check_win(self):
        win_conditions = [
            (0, 1, 2), (3, 4, 5), (6, 7, 8), # Rows
            (0, 3, 6), (1, 4, 7), (2, 5, 8), # Columns
            (0, 4, 8), (2, 4, 6)             # Diagonals
        ]
        for a, b, c in win_conditions:
            if self.board[a] == self.board[b] == self.board[c] != "":
                return True
        return False

    def disable_board(self):
        for btn in self.buttons:
            btn.config(state="disabled")

    def reset_game(self):
        self.current_player = "X"
        self.board = [""] * 9
        self.status_label.config(text=f"Player {self.current_player}'s Turn")
        for btn in self.buttons:
            btn.config(text="", state="normal")

if __name__ == "__main__":
    root = tk.Tk()
    game = TicTacToe(root)
    root.mainloop()

