# --- ROUTING CONTROLLERS ---
@app.route("/")
def index():
    return render_template_string(STORE_HTML, title="Python Flask Digital Storefront", products=PRODUCTS)

@app.route("/add_to_cart/<int:product_id>", methods=["POST"])
def add_to_cart(product_id):
    if product_id not in PRODUCTS:
        flash("Product not found!", "error")
        return redirect(url_for("index"))
        
    if "cart" not in session:
        session["cart"] = {}
        
    cart = session["cart"]
    product = PRODUCTS[product_id]
    
    current_qty = cart.get(str(product_id), 0)
    if current_qty >= product["stock"]:
        flash(f"Cannot add more units. Only {product['stock']} items available in stock!", "error")
    else:
        cart[str(product_id)] = current_qty + 1
        session["cart"] = cart
        flash(f"Added {product['name']} to your cart!", "success")
        
    return redirect(url_for("index"))

@app.route("/cart")
def view_cart():
    cart_items = []
    grand_total = 0.0
    cart = session.get("cart", {})
    
    for prod_id_str, qty in cart.items():
        p_id = int(prod_id_str)
        if p_id in PRODUCTS:
            product = PRODUCTS[p_id]
            total_price = product["price"] * qty
            grand_total += total_price
            cart_items.append({
                "id": p_id,
                "name": product["name"],
                "price": product["price"],
                "qty": qty,
                "total": total_price
            })
            
    return render_template_string(CART_HTML, title="Shopping Cart Summary", items=cart_items, grand_total=grand_total)

@app.route("/remove_item/<int:product_id>", methods=["POST"])
def remove_item(product_id):
    cart = session.get("cart", {})
    if str(product_id) in cart:
        del cart[str(product_id)]
        session["cart"] = cart
        flash("Item removed from shopping cart.", "info")
    return redirect(url_for("view_cart"))

@app.route("/checkout", methods=["POST"])
def checkout():
    cart = session.get("cart", {})
    if not cart:
        flash("Your shopping cart is empty!", "error")
        return redirect(url_for("index"))
        
    for prod_id_str, qty in cart.items():
        p_id = int(prod_id_str)
        if p_id in PRODUCTS:
            PRODUCTS[p_id]["stock"] -= qty
            
    session.pop("cart", None)
    flash("📦 Order Placed Successfully! Your transaction invoice receipt has been compiled.", "success")
    return redirect(url_for("index"))

if __name__ == "__main__":
    app.run(debug=True)
